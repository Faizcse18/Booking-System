{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "booking-system",
"main": "src/index.js",
"compatibility_date": "2026-09-16",


"observability": {
	"enabled": true
},

"upload_source_maps": true,

"assets": {
	"directory": "./public"
},

"ratelimits": [
	{
		"name": "EVENTS_RATE_LIMIT",
		"namespace_id": "2001",
		"simple": {
			"limit": 60,
			"period": 60
		}
	},
	{
		"name": "USERS_RATE_LIMIT",
		"namespace_id": "2002",
		"simple": {
			"limit": 5,
			"period": 60
		}
	},
	{
		"name": "BOOK_RATE_LIMIT",
		"namespace_id": "2003",
		"simple": {
			"limit": 10,
			"period": 60
		}
	},
	{
		"name": "BOOKINGS_RATE_LIMIT",
		"namespace_id": "2004",
		"simple": {
			"limit": 20,
			"period": 60
		}
	}
],

"d1_databases": [
	{
		"binding": "booking_db",
		"database_name": "booking-db",
		"database_id": "a6ea0859-4d3f-46ff-88dd-e6be3c051f2b"
	}
]

}
